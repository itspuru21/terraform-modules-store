# ----------------------------------------------------------------------------
# Terraform Core
# ----------------------------------------------------------------------------
# Local .terraform directories (Recursive globbing for monorepo support)
**/.terraform/*
.terraform/

# .tfstate files (Never commit these)
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files (Prevent leaking secrets)
*.tfvars
*.tfvars.json

# Exception: Allow example variables to be committed for your 'examples/' folders
!*.example.tfvars
!example.tfvars
!terraform.tfvars.example

# Ignore override files used for local testing
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore transient lock info files created by terraform apply
.terraform.tfstate.lock.info

# Ignore plan files (tfplan files can contain plaintext secrets)
*tfplan*
*.plan
planout

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Optional: ignore graph output files
*.dot

# ----------------------------------------------------------------------------
# Python (For your custom GitHub Actions & Automation Scripts)
# ----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.pytest_cache/

# ----------------------------------------------------------------------------
# DevOps Tools & CI/CD
# ----------------------------------------------------------------------------
# Infracost cache and local reports
.infracost/
infracost-base.json
infracost.json

# ----------------------------------------------------------------------------
# OS & Editor Defaults
# ----------------------------------------------------------------------------
.DS_Store
Thumbs.db
.vscode/
.idea/
